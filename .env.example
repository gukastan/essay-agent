# Process environment wins over local dotenv. Never commit real keys.
LLM_BACKEND=openai
OPENAI_API_KEY=sk-...
# Both ChatOpenAI roles require Structured Outputs support; one model may fill both.
OPENAI_FAST_MODEL=gpt-4o
OPENAI_QUALITY_MODEL=gpt-4o
LANGCHAIN_TRACING_V2=false
# Optional tracing: configure LANGCHAIN_API_KEY and LANGCHAIN_PROJECT locally.
ESSAY_DB_PATH=session.db
ESSAY_MCP_ENABLED=1
# Launchers honor these; direct Python entrypoints use 8100/8600.
AGENT_PORT=8100
FRONTEND_PORT=8600
AGENT_BASE_URL=http://127.0.0.1:8100
